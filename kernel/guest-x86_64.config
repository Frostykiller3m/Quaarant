# qt guest kernel config fragment (x86_64), merged on top of `make tinyconfig` by
# scripts/build-kernel.sh. Everything a Firecracker guest running qt-agent needs, nothing else:
# no modules, no PCI, no graphics, no sound, no USB, no wireless.
# build-kernel.sh fails if Kconfig drops any option listed here.

CONFIG_LOCALVERSION="-qt"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_64BIT=y
CONFIG_SMP=y
# CONFIG_MODULES is not set

# Firecracker / KVM guest
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PVH=y
CONFIG_ACPI=y
# Firecracker bumps the VM generation ID on snapshot restore; the kernel then reseeds its RNG,
# so restored sandboxes never share random state.
CONFIG_VIRT_DRIVERS=y
CONFIG_VMGENID=y
CONFIG_PCI=y

# Console (Firecracker's serial port; qt keeps it for boot logs only)
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# Userspace basics (glibc, musl and busybox programs; qt-agent's PTYs and seccomp)
CONFIG_MULTIUSER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_FILE_LOCKING=y
CONFIG_POSIX_TIMERS=y
CONFIG_FHANDLE=y
CONFIG_RSEQ=y
CONFIG_SYSVIPC=y
CONFIG_INOTIFY_USER=y
# qt-agent's event sources (M2-T3): fanotify for files, the proc connector for exec
CONFIG_FANOTIFY=y
CONFIG_CONNECTOR=y
CONFIG_PROC_EVENTS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Filesystems
CONFIG_BLK_DEV_INITRD=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y

# virtio-mmio devices: root disk, vsock to qtd, entropy, network (M3)
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
# no automatic sit0 tunnel device: a --net=none sandbox has only lo
# CONFIG_IPV6_SIT is not set
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
